# Environment Variables Template
# Copy this file to .env.local and fill in your actual private credentials.

# Option A: HubSpot Direct Integration (HubSpot Forms API)
VITE_HUBSPOT_PORTAL_ID=your_hubspot_portal_id_here
VITE_HUBSPOT_FORM_GUID=your_hubspot_form_guid_here

# Option B & C: Custom Webhook / Google Sheets / PostgreSQL API Endpoint
VITE_LEAD_COLLECTION_ENDPOINT=your_webhook_or_api_url_here
